# Scratch test harnesses used during development sessions — never meant to ship.
_claude_test_*.html

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp

# Local secrets, if ever introduced (none committed today — provider keys
# live as Netlify environment variables, not files in this repo).
.env
.env.local

# Supabase CLI local link/cache state (machine-specific — records which
# Supabase project `supabase` commands target). Never commit this: it's
# not portable between machines, and a stale copy here once accidentally
# pointed at the wrong (Compasso) project. Run `supabase link --project-ref
# <compasso-ref>` locally whenever you need it; don't rely on it being
# checked in.
.temp/
supabase/.temp/
